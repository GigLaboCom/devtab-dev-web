---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { messages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  /** The page's column width class, so that the header lines up with it. */
  column?: string;
}

const { locale, column = 'max-w-3xl' } = Astro.props;
const t = messages(locale);
---

<header class="border-b border-border">
  <div class={`mx-auto flex w-full ${column} items-center justify-between gap-4 px-6 py-4`}>
    <a href={getRelativeLocaleUrl(locale, '')} class="font-semibold tracking-tight">
      {t.site.name}
    </a>
    <slot />
  </div>
</header>
