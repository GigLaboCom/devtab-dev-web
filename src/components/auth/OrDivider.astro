---
/** The line between two ways of signing in, with "or" in the middle. */
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<p class="my-6 flex items-center gap-3 text-xs tracking-wide text-muted-foreground uppercase">
  <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
  {label}
  <span class="h-px flex-1 bg-border" aria-hidden="true"></span>
</p>
