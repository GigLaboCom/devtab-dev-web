---
/**
 * /forgot-password/: a mail to set a new password (the `password` method;
 * 404 when it is off), from a form posting to `/auth/password/`. The mail
 * carries a link, which works in this browser and comes back through
 * `/auth/callback/`, and a code, which this page then asks for. Either one
 * leads to /reset-password/. The page does not say whether the address has
 * an account. Personal: never cached, never indexed.
 */
import AuthCard from '../../components/auth/AuthCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fill, localeOfParam, messages } from '../../i18n';
import { authConfig, enabledMethods, safeNext } from '../../lib/auth/config';
import { RECOVERY_PENDING_COOKIE, authHref } from '../../lib/auth/server';
import { ui } from '../../lib/auth/ui';

export const prerender = false;

const locale = localeOfParam(Astro.params.locale);
// No page here: the server answers with the site's 404 page.
if (!locale || !enabledMethods().has('password')) return new Response(null, { status: 404 });
const all = messages(locale).pages;
const t = all.forgotPassword;
const s = all.signIn;
Astro.response.headers.set('Cache-Control', 'no-store');

const nextRaw = Astro.url.searchParams.get('next');
const next = nextRaw ? safeNext(nextRaw, '') : '';
const configured = authConfig() !== null;
const pending = Astro.cookies.get(RECOVERY_PENDING_COOKIE)?.value;
const errors: Record<string, string> = {
  email: s.errorEmail,
  send: s.errorSend,
  code: s.errorCode,
  link: t.errorLink,
  rate: s.errorRate,
  unavailable: s.unavailable,
};
const error = errors[Astro.url.searchParams.get('error') ?? ''];
---

<BaseLayout locale={locale} page="forgotPassword">
  <AuthCard heading={t.heading} error={error}>
    {!configured && <p>{s.unavailable}</p>}
    {configured && pending && (
      <>
        <p>{fill(t.sent, { email: pending })}</p>
        <p class={`mt-2 ${ui.note}`}>{s.sentNote}</p>
        <form method="post" action="/auth/password/" class="mt-5">
          <input type="hidden" name="step" value="code" />
          <input type="hidden" name="locale" value={locale} />
          {next && <input type="hidden" name="next" value={next} />}
          <label for="code" class={ui.label}>
            {s.codeLabel}
          </label>
          <input
            id="code"
            name="code"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9 ]{6,12}"
            required
            class={ui.field}
          />
          <button type="submit" class={ui.primary}>
            {t.verify}
          </button>
        </form>
        <form method="post" action="/auth/password/" class="mt-4 text-center">
          <input type="hidden" name="step" value="again" />
          <input type="hidden" name="locale" value={locale} />
          {next && <input type="hidden" name="next" value={next} />}
          <button type="submit" class={ui.quiet}>
            {s.otherAddress}
          </button>
        </form>
      </>
    )}
    {configured && !pending && (
      <form method="post" action="/auth/password/">
        <p class={ui.note}>{t.intro}</p>
        <input type="hidden" name="step" value="forgot" />
        <input type="hidden" name="locale" value={locale} />
        {next && <input type="hidden" name="next" value={next} />}
        <label for="email" class={`mt-4 ${ui.label}`}>
          {s.emailLabel}
        </label>
        <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" class={ui.field} />
        <button type="submit" class={ui.primary}>
          {s.send}
        </button>
      </form>
    )}
    <p slot="after" class={`mt-6 text-center ${ui.note}`}>
      <a href={authHref(locale, 'signIn', next)} class={ui.link}>
        {t.back}
      </a>
    </p>
  </AuthCard>
</BaseLayout>
