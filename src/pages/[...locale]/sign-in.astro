---
/**
 * /sign-in/: signing in to an account of the site (Supabase Auth), by the
 * methods this deployment offers (`DEVTAB_SIGN_IN_METHODS`,
 * src/lib/auth/config.ts): Google (a link to `/auth/google/`), an address
 * and a password (a form posting to `/auth/password/`, with links to
 * /sign-up/ and /forgot-password/), and a mail with a link and a one-time
 * code (forms posting to `/auth/sign-in/`). No script. While a code is
 * awaited (after the e-mail form, or a sign-up), the page asks for it.
 * Signed in, it shows who and offers signing out; asked with
 * `?next=<path of this site>`, it sends a signed-in person straight there,
 * and the forms carry it through the sign-in. Personal: never cached, never
 * indexed.
 */
import AuthCard from '../../components/auth/AuthCard.astro';
import GoogleLink from '../../components/auth/GoogleLink.astro';
import OrDivider from '../../components/auth/OrDivider.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fill, localeOfParam, messages } from '../../i18n';
import { authConfig, enabledMethods, safeNext } from '../../lib/auth/config';
import { PENDING_COOKIE, authHref } from '../../lib/auth/server';
import { ui } from '../../lib/auth/ui';

export const prerender = false;

const locale = localeOfParam(Astro.params.locale);
// No page here: the server answers with the site's 404 page.
if (!locale) return new Response(null, { status: 404 });
const t = messages(locale).pages.signIn;
Astro.response.headers.set('Cache-Control', 'no-store');

const nextRaw = Astro.url.searchParams.get('next');
const next = nextRaw ? safeNext(nextRaw, '') : '';
const signedIn = Astro.locals.auth;
if (signedIn && next) return Astro.redirect(next, 303);

const methods = enabledMethods();
const google = methods.has('google');
const password = methods.has('password');
const email = methods.has('email');
const configured = authConfig() !== null && methods.size > 0;
const pending = signedIn || (!email && !password) ? undefined : Astro.cookies.get(PENDING_COOKIE)?.value;
const errors: Record<string, string> = {
  email: t.errorEmail,
  send: t.errorSend,
  code: t.errorCode,
  link: t.errorLink,
  rate: t.errorRate,
  unavailable: t.unavailable,
  credentials: t.errorCredentials,
  unconfirmed: t.errorUnconfirmed,
  failed: t.errorFailed,
  google: t.errorGoogle,
};
const notices: Record<string, string> = { password: t.passwordChanged };
const error = signedIn ? undefined : errors[Astro.url.searchParams.get('error') ?? ''];
const notice = notices[Astro.url.searchParams.get('notice') ?? ''];
---

<BaseLayout locale={locale} page="signIn">
  <AuthCard heading={t.heading} error={error} notice={notice}>
    {!configured && <p>{t.unavailable}</p>}
    {configured && signedIn && (
      <>
        <p>{fill(t.signedIn, { email: signedIn.email ?? '' })}</p>
        <form method="post" action="/auth/signout/">
          <input type="hidden" name="locale" value={locale} />
          <button type="submit" class={ui.primary}>
            {t.signOut}
          </button>
        </form>
      </>
    )}
    {configured && !signedIn && pending && (
      <>
        <p>{fill(t.sent, { email: pending })}</p>
        <p class={`mt-2 ${ui.note}`}>{t.sentNote}</p>
        <form method="post" action="/auth/sign-in/" class="mt-5">
          <input type="hidden" name="step" value="code" />
          <input type="hidden" name="locale" value={locale} />
          {next && <input type="hidden" name="next" value={next} />}
          <label for="code" class={ui.label}>
            {t.codeLabel}
          </label>
          <input
            id="code"
            name="code"
            inputmode="numeric"
            autocomplete="one-time-code"
            pattern="[0-9 ]{6,12}"
            required
            class={ui.field}
          />
          <button type="submit" class={ui.primary}>
            {t.verify}
          </button>
        </form>
        <form method="post" action="/auth/sign-in/" class="mt-4 text-center">
          <input type="hidden" name="step" value="reset" />
          <input type="hidden" name="locale" value={locale} />
          {next && <input type="hidden" name="next" value={next} />}
          <button type="submit" class={ui.quiet}>
            {t.otherAddress}
          </button>
        </form>
      </>
    )}
    {configured && !signedIn && !pending && (
      <>
        {google && <GoogleLink locale={locale} next={next} label={t.google} />}
        {google && (password || email) && <OrDivider label={t.or} />}
        {password && (
          <form method="post" action="/auth/password/">
            <input type="hidden" name="step" value="sign-in" />
            <input type="hidden" name="locale" value={locale} />
            {next && <input type="hidden" name="next" value={next} />}
            <label for="password-email" class={ui.label}>
              {t.emailLabel}
            </label>
            <input
              id="password-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
              class={ui.field}
            />
            <div class="mt-4 flex items-baseline justify-between gap-4">
              <label for="password" class={ui.label}>
                {t.passwordLabel}
              </label>
              <a href={authHref(locale, 'forgotPassword', next)} class={`text-sm ${ui.link}`}>
                {t.forgot}
              </a>
            </div>
            <input
              id="password"
              name="password"
              type="password"
              autocomplete="current-password"
              required
              maxlength="72"
              class={ui.field}
            />
            <button type="submit" class={ui.primary}>
              {t.signInPassword}
            </button>
          </form>
        )}
        {password && email && <OrDivider label={t.or} />}
        {email && (
          <form method="post" action="/auth/sign-in/">
            <p class={ui.note}>{t.intro}</p>
            <input type="hidden" name="step" value="email" />
            <input type="hidden" name="locale" value={locale} />
            {next && <input type="hidden" name="next" value={next} />}
            <label for="email" class={`mt-4 ${ui.label}`}>
              {t.emailLabel}
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
              class={ui.field}
            />
            <button type="submit" class={password ? ui.alternative : ui.primary}>
              {t.send}
            </button>
          </form>
        )}
      </>
    )}
    {configured && !signedIn && !pending && password && (
      <p slot="after" class={`mt-6 text-center ${ui.note}`}>
        {t.noAccount}{' '}
        <a href={authHref(locale, 'signUp', next)} class={ui.link}>
          {t.signUp}
        </a>
      </p>
    )}
  </AuthCard>
</BaseLayout>
