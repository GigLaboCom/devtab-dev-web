---
/**
 * /sign-in/: signing in to an account of the site by e-mail, with a link or a
 * one-time code from the mail (Supabase Auth), in plain forms that post to
 * `/auth/sign-in/`: no script. Signed in, it shows who and offers signing
 * out; asked with `?next=<path of this site>`, it sends a signed-in person
 * straight there, and the forms carry it through the sign-in. Personal:
 * never cached, never indexed.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fill, localeOfParam, messages } from '../../i18n';
import { authConfig, safeNext } from '../../lib/auth/config';
import { PENDING_COOKIE } from '../../lib/auth/server';

export const prerender = false;

const locale = localeOfParam(Astro.params.locale);
// No page here: the server answers with the site's 404 page.
if (!locale) return new Response(null, { status: 404 });
const t = messages(locale).pages.signIn;
Astro.response.headers.set('Cache-Control', 'no-store');

const nextRaw = Astro.url.searchParams.get('next');
const next = nextRaw ? safeNext(nextRaw, '') : '';
const signedIn = Astro.locals.auth;
if (signedIn && next) return Astro.redirect(next, 303);

const configured = authConfig() !== null;
const pending = signedIn ? undefined : Astro.cookies.get(PENDING_COOKIE)?.value;
const errors: Record<string, string> = {
  email: t.errorEmail,
  send: t.errorSend,
  code: t.errorCode,
  link: t.errorLink,
  rate: t.errorRate,
  unavailable: t.unavailable,
};
const error = errors[Astro.url.searchParams.get('error') ?? ''];
const field = 'mt-1 w-full rounded-md border border-border bg-background px-3 py-2';
const button = 'mt-4 inline-flex rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground';
const quiet = 'mt-4 text-sm text-muted-foreground underline underline-offset-4';
---

<BaseLayout locale={locale} page="signIn">
  <h1 class="text-4xl font-semibold tracking-tight">{t.heading}</h1>
  {error && !signedIn && (
    <p role="alert" class="mt-4 rounded-md border border-border px-3 py-2">
      {error}
    </p>
  )}
  {!configured && <p class="mt-4 text-lg">{t.unavailable}</p>}
  {configured && signedIn && (
    <>
      <p class="mt-4 text-lg">{fill(t.signedIn, { email: signedIn.email ?? '' })}</p>
      <form method="post" action="/auth/signout/">
        <input type="hidden" name="locale" value={locale} />
        <button type="submit" class={button}>
          {t.signOut}
        </button>
      </form>
    </>
  )}
  {configured && !signedIn && !pending && (
    <form method="post" action="/auth/sign-in/" class="mt-6 max-w-sm">
      <p>{t.intro}</p>
      <input type="hidden" name="step" value="email" />
      <input type="hidden" name="locale" value={locale} />
      {next && <input type="hidden" name="next" value={next} />}
      <label for="email" class="mt-4 block text-sm font-medium">
        {t.emailLabel}
      </label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" class={field} />
      <button type="submit" class={button}>
        {t.send}
      </button>
    </form>
  )}
  {configured && !signedIn && pending && (
    <div class="mt-6 max-w-sm">
      <p>{fill(t.sent, { email: pending })}</p>
      <p class="mt-2 text-muted-foreground">{t.sentNote}</p>
      <form method="post" action="/auth/sign-in/">
        <input type="hidden" name="step" value="code" />
        <input type="hidden" name="locale" value={locale} />
        {next && <input type="hidden" name="next" value={next} />}
        <label for="code" class="mt-4 block text-sm font-medium">
          {t.codeLabel}
        </label>
        <input
          id="code"
          name="code"
          inputmode="numeric"
          autocomplete="one-time-code"
          pattern="[0-9 ]{6,12}"
          required
          class={field}
        />
        <button type="submit" class={button}>
          {t.verify}
        </button>
      </form>
      <form method="post" action="/auth/sign-in/">
        <input type="hidden" name="step" value="reset" />
        <input type="hidden" name="locale" value={locale} />
        {next && <input type="hidden" name="next" value={next} />}
        <button type="submit" class={quiet}>
          {t.otherAddress}
        </button>
      </form>
    </div>
  )}
</BaseLayout>
