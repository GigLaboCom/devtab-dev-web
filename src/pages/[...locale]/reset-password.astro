---
/**
 * /reset-password/: the new password (the `password` method; 404 when it is
 * off), in a form posting to `/auth/password/`. Only in the session that a
 * password reset mail's link or code started (`RESET_COOKIE`, an hour);
 * otherwise the page says so and links to /forgot-password/. Personal:
 * never cached, never indexed.
 */
import AuthCard from '../../components/auth/AuthCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { fill, localeOfParam, messages } from '../../i18n';
import { authConfig, enabledMethods, safeNext } from '../../lib/auth/config';
import { authHref, inResetSession } from '../../lib/auth/server';
import { ui } from '../../lib/auth/ui';

export const prerender = false;

const locale = localeOfParam(Astro.params.locale);
// No page here: the server answers with the site's 404 page.
if (!locale || !enabledMethods().has('password')) return new Response(null, { status: 404 });
const all = messages(locale).pages;
const t = all.resetPassword;
const s = all.signIn;
Astro.response.headers.set('Cache-Control', 'no-store');

const nextRaw = Astro.url.searchParams.get('next');
const next = nextRaw ? safeNext(nextRaw, '') : '';
const configured = authConfig() !== null;
const person = Astro.locals.auth;
const ready = configured && inResetSession(Astro.cookies, person);
const errors: Record<string, string> = {
  rate: s.errorRate,
  unavailable: s.unavailable,
  update: t.errorUpdate,
  'password-weak': s.errorPasswordWeak,
  'password-long': s.errorPasswordLong,
  'password-mismatch': s.errorPasswordMismatch,
  'password-same': t.errorSame,
};
const error = ready ? errors[Astro.url.searchParams.get('error') ?? ''] : undefined;
---

<BaseLayout locale={locale} page="resetPassword">
  <AuthCard heading={t.heading} error={error}>
    {!configured && <p>{s.unavailable}</p>}
    {configured && !ready && (
      <>
        <p>{t.expired}</p>
        <a href={authHref(locale, 'forgotPassword', next)} class={ui.primary}>
          {t.again}
        </a>
      </>
    )}
    {ready && (
      <form method="post" action="/auth/password/">
        <p class={ui.note}>{fill(t.intro, { email: person?.email ?? '' })}</p>
        <input type="hidden" name="step" value="update" />
        <input type="hidden" name="locale" value={locale} />
        {next && <input type="hidden" name="next" value={next} />}
        <label for="password" class={`mt-4 ${ui.label}`}>
          {t.passwordLabel}
        </label>
        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          required
          maxlength="72"
          class={ui.field}
        />
        <label for="confirm" class={`mt-4 ${ui.label}`}>
          {t.confirmLabel}
        </label>
        <input
          id="confirm"
          name="confirm"
          type="password"
          autocomplete="new-password"
          required
          maxlength="72"
          class={ui.field}
        />
        <button type="submit" class={ui.primary}>
          {t.submit}
        </button>
      </form>
    )}
  </AuthCard>
</BaseLayout>
