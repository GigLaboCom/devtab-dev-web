---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { localeStaticPaths, messages, type Locale } from '../../i18n';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = messages(locale).pages.home;
---

<BaseLayout locale={locale} page="home">
  <h1 class="text-4xl font-semibold tracking-tight">{t.heading}</h1>
  <p class="mt-4 text-lg">{t.lede}</p>
  <p class="mt-2 text-muted-foreground">{t.placeholder}</p>
</BaseLayout>
