---
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import LanguageSwitch from '../components/LanguageSwitch.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { defaultLocale, locales, messages, type Locale } from '../i18n';
import { pages, type PageId } from '../lib/pages';
import { serverPages, type ServerPageId } from '../lib/serverPages';
import '../styles/global.css';

interface Props {
  locale: Locale;
  /**
   * The page of `src/lib/pages.ts` or `src/lib/serverPages.ts`; none for the
   * 404, which is not indexed and has no alternates.
   */
  page?: PageId | ServerPageId;
}

const { locale, page } = Astro.props;
const t = messages(locale);
const server = page !== undefined && page in serverPages ? serverPages[page as ServerPageId] : undefined;
const path = page === undefined ? undefined : (server?.path ?? pages[page as PageId]);
const noindex = path === undefined || server?.index === false;
const { title, description } = page === undefined ? t.notFound : t.pages[page];
const fullTitle = title === t.site.name ? title : `${title} · ${t.site.name}`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {noindex && <meta name="robots" content="noindex" />}
    {path !== undefined && (
      <>
        <link rel="canonical" href={getAbsoluteLocaleUrl(locale, path)} />
        {locales.map(other => (
          <link rel="alternate" hreflang={other} href={getAbsoluteLocaleUrl(other, path)} />
        ))}
        <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(defaultLocale, path)} />
        <meta property="og:url" content={getAbsoluteLocaleUrl(locale, path)} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t.site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={locale} />
    {locales
      .filter(other => other !== locale)
      .map(other => (
        <meta property="og:locale:alternate" content={other} />
      ))}
  </head>
  <body class="flex min-h-dvh flex-col bg-background font-sans text-foreground antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:rounded-md focus:bg-primary focus:px-3 focus:py-2 focus:text-primary-foreground">
      {t.site.skipToContent}
    </a>
    <SiteHeader locale={locale}>
      <LanguageSwitch locale={locale} path={path} />
    </SiteHeader>
    <main id="main" class="mx-auto flex w-full max-w-3xl flex-1 flex-col justify-center px-6 py-16">
      <slot />
    </main>
  </body>
</html>
