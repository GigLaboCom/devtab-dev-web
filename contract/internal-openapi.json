{
  "openapi": "3.1.0",
  "info": {
    "title": "devtab-api internal",
    "description": "The internal listener of devtab-api, for the site's own pages only. Every error answers {\"error\": \"<kebab-case code>\", \"message\": \"<English text>\"}.",
    "version": "0.1.0"
  },
  "paths": {
    "/internal/checkouts": {
      "post": {
        "tags": [
          "purchase"
        ],
        "summary": "`POST /internal/checkouts`: starts a checkout of a plan for the\nsigned-in person.",
        "operationId": "start",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCheckout"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedCheckout"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`plan-unknown`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`plan-unavailable`: not sold now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`payments-unavailable`: no provider, or it did not start",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/checkouts/guest": {
      "post": {
        "tags": [
          "purchase"
        ],
        "summary": "`POST /internal/checkouts/guest`: starts a checkout of a plan without an\naccount, where the deployment allows it (`DEVTAB_GUEST_CHECKOUT`). The\nprovider asks the buyer for an address; when the payment is through, the\nlicence goes to that address's account, made and invited by mail if\nthere is none. The site limits how often one client may start one.",
        "operationId": "start_guest",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewCheckout"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedGuestCheckout"
                }
              }
            }
          },
          "403": {
            "description": "`guest-checkout-off`: not offered here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`plan-unknown`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`plan-unavailable`: not sold now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "`guest-checkout-unavailable`: no Supabase secret key to invite the buyer with; `payments-unavailable`: no provider, or it did not start",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/internal/checkouts/{id}": {
      "get": {
        "tags": [
          "purchase"
        ],
        "summary": "`GET /internal/checkouts/{id}`: how the signed-in person's checkout went.",
        "operationId": "read",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The checkout, the `ref` of the return address",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The checkout's state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckoutState"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such checkout of this person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/checkouts/{id}/claim": {
      "post": {
        "tags": [
          "purchase"
        ],
        "summary": "`POST /internal/checkouts/{id}/claim`: how a guest checkout went, for the\nbrowser that started it (the secret its start answered).",
        "operationId": "claim",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The checkout, the `ref` of the return address",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckoutClaim"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The checkout's state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GuestCheckoutState"
                }
              }
            }
          },
          "404": {
            "description": "No such guest checkout with this secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/internal/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "`GET /internal/healthz`.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/internal/licences/connect": {
      "post": {
        "tags": [
          "licences"
        ],
        "summary": "`POST /internal/licences/connect`.",
        "operationId": "connect",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConnectRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Activated for the installation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connected"
                }
              }
            }
          },
          "400": {
            "description": "Not an installation id or a licence id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`key-blocked` or `licence-inactive`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "`no-licence`, or `not-found` for a licence that is not theirs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`seat-limit`: every usable licence is full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/licences/{lid}/members": {
      "get": {
        "tags": [
          "licences"
        ],
        "summary": "`GET /internal/licences/{lid}/members`.",
        "operationId": "list",
        "parameters": [
          {
            "name": "lid",
            "in": "path",
            "description": "The team licence",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The team",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Team"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such licence of this person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not-a-team`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "licences"
        ],
        "summary": "`POST /internal/licences/{lid}/members`.",
        "operationId": "invite",
        "parameters": [
          {
            "name": "lid",
            "in": "path",
            "description": "The team licence",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Invite"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Invited (or already invited)"
          },
          "400": {
            "description": "Not an e-mail address",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such licence of this person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not-a-team`, or `team-full`: every member bought is invited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/licences/{lid}/members/{email}": {
      "delete": {
        "tags": [
          "licences"
        ],
        "summary": "`DELETE /internal/licences/{lid}/members/{email}`.",
        "operationId": "remove",
        "parameters": [
          {
            "name": "lid",
            "in": "path",
            "description": "The team licence",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "email",
            "in": "path",
            "description": "The member's address",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed; the browsers they connected are disconnected"
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "404": {
            "description": "No such licence of this person, or no such member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`not-a-team`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/me": {
      "get": {
        "tags": [
          "account"
        ],
        "summary": "`GET /internal/me`: who the access token says is signed in. Never cached.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in person",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "The account is blocked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The project's signing keys or the database cannot be reached, or sign-in is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/internal/plans": {
      "get": {
        "tags": [
          "plans"
        ],
        "summary": "`GET /internal/plans`: the catalogue for the site's pages.",
        "operationId": "internal_plans",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "description": "The language of the plans' texts; `en` when absent.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Locale"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Every plan whose offer has not ended, in the order of the cards, with the texts of the language asked for; `available` says which can be bought now",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteCatalogue"
                }
              }
            }
          },
          "304": {
            "description": "Not modified: the `If-None-Match` names the current `ETag`"
          },
          "400": {
            "description": "An unknown language",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "503": {
            "description": "The database cannot be reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/internal/trials": {
      "post": {
        "tags": [
          "purchase"
        ],
        "summary": "`POST /internal/trials`.",
        "operationId": "start_trial",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewTrial"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedTrial"
                }
              }
            }
          },
          "401": {
            "description": "No access token, or one that does not pass",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`trial-off`: no trial is offered here",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "409": {
            "description": "`trial-used`: this inbox had one (any spelling, any account); `trial-not-eligible`: the account had a paid licence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "BuyerAccount": {
        "type": "string",
        "description": "How a guest checkout's buyer got the account its licence is in.",
        "enum": [
          "invited",
          "existing"
        ]
      },
      "CheckoutClaim": {
        "type": "object",
        "description": "The secret of a guest checkout, as the site kept it.",
        "required": [
          "claim"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "description": "`claim` of the started guest checkout."
          }
        },
        "additionalProperties": false
      },
      "CheckoutState": {
        "type": "object",
        "description": "A checkout as its buyer sees it.",
        "required": [
          "status",
          "key",
          "key_hint"
        ],
        "properties": {
          "key": {
            "type": [
              "string",
              "null"
            ],
            "description": "The licence key: only the first time a completed checkout is asked\nfor, within a day of the licence; null ever after."
          },
          "key_hint": {
            "type": [
              "string",
              "null"
            ],
            "description": "The key's last four characters, once completed."
          },
          "status": {
            "$ref": "#/components/schemas/CheckoutStatus"
          }
        }
      },
      "CheckoutStatus": {
        "type": "string",
        "description": "Where a checkout stands.",
        "enum": [
          "open",
          "completed",
          "expired"
        ]
      },
      "ConnectRequest": {
        "type": "object",
        "description": "The installation to connect.",
        "required": [
          "inst"
        ],
        "properties": {
          "inst": {
            "type": "string",
            "description": "The extension's installation id: 22 base64url characters."
          },
          "lid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Which licence; without it the API picks (the one this installation is\non, else the longest-running with a free seat)."
          }
        },
        "additionalProperties": false
      },
      "Connected": {
        "type": "object",
        "description": "What the extension stores, as after `POST /v1/activate`.",
        "required": [
          "lid",
          "token",
          "secret"
        ],
        "properties": {
          "lid": {
            "type": "string"
          },
          "secret": {
            "type": "string",
            "description": "The installation's secret; shown to nobody but the extension."
          },
          "token": {
            "type": "string",
            "description": "The signed licence token."
          }
        }
      },
      "EmbeddedCheckout": {
        "type": "object",
        "description": "Stripe's form for the site's own page.",
        "required": [
          "client_secret",
          "publishable_key",
          "api_version"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "description": "Stripe.js of this API version mounts the form."
          },
          "client_secret": {
            "type": "string"
          },
          "publishable_key": {
            "type": "string",
            "description": "Public by design."
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "description": "The body of every error answer.",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "A kebab-case code."
          },
          "message": {
            "type": "string",
            "description": "English text for logs and people."
          }
        }
      },
      "GuestCheckoutState": {
        "type": "object",
        "description": "A guest checkout as the browser that started it sees it.",
        "required": [
          "status",
          "key",
          "key_hint",
          "account"
        ],
        "properties": {
          "account": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BuyerAccount",
                "description": "Once paid: whether the buyer was invited or had an account."
              }
            ]
          },
          "key": {
            "type": [
              "string",
              "null"
            ],
            "description": "As [`CheckoutState::key`]: the first time it is asked for, by this\nbrowser or by the buyer's account, whichever comes first."
          },
          "key_hint": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "$ref": "#/components/schemas/CheckoutStatus"
          }
        }
      },
      "Health": {
        "type": "object",
        "description": "The process is up.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Always `ok`."
          }
        }
      },
      "Invite": {
        "type": "object",
        "description": "An address to invite.",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "locale": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Locale",
                "description": "The language of the invitation's mail (English when absent)."
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "Locale": {
        "type": "string",
        "description": "The languages of the site's pages.",
        "enum": [
          "en",
          "ru"
        ]
      },
      "Me": {
        "type": "object",
        "description": "The signed-in person, as the API knows them.",
        "required": [
          "user",
          "email"
        ],
        "properties": {
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The account's e-mail address, from Supabase Auth."
          },
          "user": {
            "type": "string",
            "format": "uuid",
            "description": "The person's id: the access token's `sub`."
          }
        }
      },
      "Member": {
        "type": "object",
        "description": "One invited address.",
        "required": [
          "email",
          "joined"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "joined": {
            "type": "boolean",
            "description": "The person has signed in with it and connected."
          }
        }
      },
      "NewCheckout": {
        "type": "object",
        "description": "A checkout to start.",
        "required": [
          "plan"
        ],
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "description": "The language of the provider's page, the return page and the mail."
          },
          "members": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "A team plan: how many members to start with (its smallest team when\nabsent; the buyer may change it on the provider's page). Not for a\npersonal plan.",
            "minimum": 0
          },
          "plan": {
            "type": "string",
            "description": "The plan's id, such as `pro-monthly`."
          }
        },
        "additionalProperties": false
      },
      "NewTrial": {
        "type": "object",
        "description": "A trial to start.",
        "properties": {
          "locale": {
            "$ref": "#/components/schemas/Locale",
            "description": "The language of the trial's mails."
          }
        },
        "additionalProperties": false
      },
      "Plan": {
        "type": "object",
        "description": "A plan as its card shows it.",
        "required": [
          "id",
          "kind",
          "term",
          "name",
          "summary",
          "includes",
          "price",
          "priceNote",
          "badge",
          "checkoutUrl",
          "until"
        ],
        "properties": {
          "badge": {
            "type": [
              "string",
              "null"
            ],
            "description": "At most 24 characters."
          },
          "checkoutUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where a paid plan is bought; null for a free plan."
          },
          "id": {
            "type": "string",
            "description": "`[a-z0-9-]{1,32}`; never changes."
          },
          "includes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "0–8 lines of 1–100 characters, in the order to show."
          },
          "kind": {
            "$ref": "#/components/schemas/PlanKind"
          },
          "name": {
            "type": "string",
            "description": "1–32 characters."
          },
          "price": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Price",
                "description": "A paid plan's price; null for a free plan."
              }
            ]
          },
          "priceNote": {
            "type": [
              "string",
              "null"
            ],
            "description": "At most 60 characters."
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "description": "At most 140 characters."
          },
          "term": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Term",
                "description": "A paid plan's billing period; null for a free plan."
              }
            ]
          },
          "until": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "The end of a limited offer, Unix seconds."
          }
        }
      },
      "PlanKind": {
        "type": "string",
        "description": "`free` or `paid`.",
        "enum": [
          "free",
          "paid"
        ]
      },
      "Price": {
        "type": "object",
        "description": "A price: the amount in the currency's minor units, and the currency.",
        "required": [
          "amount",
          "currency"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Minor units (cents), 0 to 100 000 000."
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217, upper case."
          }
        }
      },
      "PriceTier": {
        "type": "object",
        "description": "A step of a team plan's price.",
        "required": [
          "upTo",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "integer",
            "format": "int64",
            "description": "Per member, in minor units."
          },
          "upTo": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Up to this many members; null: any number above the previous step.",
            "minimum": 0
          }
        }
      },
      "SiteCatalogue": {
        "type": "object",
        "description": "The answer of `GET /internal/plans`.",
        "required": [
          "v",
          "catalog",
          "maxAge",
          "manageUrl",
          "locale",
          "plans",
          "trialDays"
        ],
        "properties": {
          "catalog": {
            "type": "string",
            "description": "The catalogue's version."
          },
          "locale": {
            "type": "string",
            "description": "The language asked for."
          },
          "manageUrl": {
            "type": "string",
            "description": "Where a subscription is managed."
          },
          "maxAge": {
            "type": "integer",
            "format": "int32",
            "description": "Seconds the answer is fresh.",
            "minimum": 0
          },
          "plans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SitePlan"
            },
            "description": "In the order of the cards."
          },
          "trialDays": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The days of the trial without a card a signed-in person may start\n(`POST /internal/trials`); null when none is offered.",
            "minimum": 0
          },
          "v": {
            "type": "integer",
            "format": "int32",
            "description": "The format version, 1.",
            "minimum": 0
          }
        }
      },
      "SitePlan": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Plan"
          },
          {
            "type": "object",
            "required": [
              "available",
              "locale",
              "minMembers",
              "tiers"
            ],
            "properties": {
              "available": {
                "type": "boolean",
                "description": "Whether it can be bought now; the page shows \"soon\" instead of a\nbutton when not."
              },
              "locale": {
                "type": "string",
                "description": "The language of its texts: the one asked for, or `en` where the plan\nhas none in it."
              },
              "minMembers": {
                "type": [
                  "integer",
                  "null"
                ],
                "format": "int32",
                "description": "A team plan's smallest team: its price is per member. Null for a\npersonal plan."
              },
              "tiers": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/components/schemas/PriceTier"
                },
                "description": "A team plan's price steps by the team's size, in the price's\ncurrency: every member pays the step the whole team reaches. Null for\na flat price."
              }
            }
          }
        ],
        "description": "A plan as the site's pages show it."
      },
      "StartedCheckout": {
        "type": "object",
        "description": "A started checkout: where to send the buyer, or the form to mount.",
        "required": [
          "checkout"
        ],
        "properties": {
          "checkout": {
            "type": "string",
            "format": "uuid"
          },
          "embedded": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EmbeddedCheckout",
                "description": "The form (an embedded checkout)."
              }
            ]
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider's page (a hosted checkout); answer it with 303."
          }
        }
      },
      "StartedGuestCheckout": {
        "type": "object",
        "description": "A started guest checkout: as [`StartedCheckout`], with the secret that\nreads it.",
        "required": [
          "checkout",
          "claim"
        ],
        "properties": {
          "checkout": {
            "type": "string",
            "format": "uuid"
          },
          "claim": {
            "type": "string",
            "description": "The secret that reads this checkout (`POST /internal/checkouts/{id}/claim`):\nkeep it in an `HttpOnly` cookie of the browser that started it, never\nin an address or a page. Shown once; only its hash is stored."
          },
          "embedded": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EmbeddedCheckout",
                "description": "The form (an embedded checkout)."
              }
            ]
          },
          "redirect_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "The provider's page (a hosted checkout); answer it with 303."
          }
        }
      },
      "StartedTrial": {
        "type": "object",
        "description": "A started trial.",
        "required": [
          "lid",
          "key",
          "ends_at"
        ],
        "properties": {
          "ends_at": {
            "type": "string",
            "description": "When the trial ends, RFC 3339."
          },
          "key": {
            "type": "string",
            "description": "The licence key, shown only in this answer."
          },
          "lid": {
            "type": "string",
            "description": "The licence's id."
          }
        }
      },
      "Team": {
        "type": "object",
        "description": "A team's members.",
        "required": [
          "members",
          "invited"
        ],
        "properties": {
          "invited": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Member"
            },
            "description": "The invited addresses, at most `members` − 1."
          },
          "members": {
            "type": "integer",
            "format": "int32",
            "description": "Members bought, the owner included."
          }
        }
      },
      "Term": {
        "type": "string",
        "description": "A subscription's billing period.",
        "enum": [
          "month",
          "year"
        ]
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
