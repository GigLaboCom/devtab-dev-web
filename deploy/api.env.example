# The API's environment: every setting `devtab-api serve` and `devtab-api
# admin …` read, with the defaults commented out. Copy it next to the
# deployment, fill in the values, and keep the copy out of version control.
# Secrets are never values here: each is a file (mounted from the platform's
# secret store) and the variable names the file. README.md, "Configuration",
# says what each does.

# --- Environment and listeners -------------------------------------------
DEVTAB_ENV=staging                  # dev | staging | prod
# DEVTAB_PUBLIC_ADDR=0.0.0.0:8080   # health checks and /v1/* (the extension)
# DEVTAB_INTERNAL_ADDR=0.0.0.0:8081 # the site's routes; never published
# DEVTAB_LOG=info

# --- Database -------------------------------------------------------------
# The API role through a session pooler or a direct connection (not a
# transaction pooler: the queries are prepared). It carries a password: set
# it from the secret store, not in a committed file.
DEVTAB_DATABASE_URL=
# DEVTAB_DB_MAX_CONNECTIONS=10

# --- Hosts ----------------------------------------------------------------
DEVTAB_SITE_URL=https://web.example.invalid
DEVTAB_LICENCE_HOST=licence.example.invalid
# The extension's origins, comma-separated: chrome-extension://<32 letters a-p>
DEVTAB_EXTENSION_ORIGINS=
# DEVTAB_MAINTENANCE_UNTIL=          # RFC 3339; /v1/* answers 503 until then

# --- Signed-in people (Supabase Auth) ---------------------------------------
# The project's address; its JWKS checks the access tokens.
DEVTAB_SUPABASE_URL=https://project.example.invalid
# DEVTAB_JWT_ISSUER=                # default <DEVTAB_SUPABASE_URL>/auth/v1

# --- Buying without an account ---------------------------------------------
# true: a checkout may start without signing in (the site's
# DEVTAB_GUEST_CHECKOUT says the same). When it is paid, the buyer's address
# is looked up in Supabase Auth and, without an account, invited by mail
# with the project's secret key below. Without the key a guest checkout is
# refused (guest-checkout-unavailable); signed-in purchases work regardless.
# DEVTAB_GUEST_CHECKOUT=false
# The file of the project's secret key (sb_secret_…, or the legacy
# service_role key); never in the site's environment.
# DEVTAB_SUPABASE_SECRET_KEY_FILE=/run/secrets/supabase-secret-key
# Supabase Auth as the API reaches it, when not <DEVTAB_SUPABASE_URL>/auth/v1.
# DEVTAB_SUPABASE_AUTH_URL=

# --- Licence signing ------------------------------------------------------
DEVTAB_SIGNING_KEY_FILE=/run/secrets/signing-key
DEVTAB_SIGNING_KID=p1

# --- Licence timing, seats and rate limits (the contract's defaults) -------
# DEVTAB_TOKEN_CHECK_DAYS=7
# DEVTAB_TOKEN_WINDOW_DAYS=30
# DEVTAB_TOKEN_WARN_DAYS=7
# DEVTAB_TOKEN_DUNNING_DAYS=14
# DEVTAB_RELEASE_AFTER_DAYS=60
# DEVTAB_ACTIVATION_CHURN=3
# DEVTAB_RATE_ACTIVATE_PER_IP=30
# DEVTAB_RATE_ACTIVATE_PER_KEY=10
# DEVTAB_RATE_REFRESH_PER_IP=60
# DEVTAB_RATE_REFRESH_PER_INSTALLATION=6
# DEVTAB_RATE_DEACTIVATE_PER_INSTALLATION=10
# DEVTAB_RATE_PLANS_PER_IP=60

# --- Plans ----------------------------------------------------------------
# DEVTAB_PLANS_MAX_AGE=86400

# --- Payments: Stripe -------------------------------------------------------
DEVTAB_PAYMENTS=stripe              # stripe | fake (development only; refused in prod)
DEVTAB_PAYMENTS_ENV=sandbox         # sandbox | live (prod: live only)
# A restricted key of that mode (rk_test_… / rk_live_…) with the permissions
# README.md, "Payments (Stripe)", lists; never a secret key (sk_…).
DEVTAB_PAYMENTS_API_KEY_FILE=/run/secrets/payments-api-key
# The webhook destination's signing secret (whsec_…); `serve` needs it.
DEVTAB_PAYMENTS_WEBHOOK_SECRET_FILE=/run/secrets/payments-webhook-secret
# Stripe sells as merchant of record (Managed Payments); false: the account
# sells, and DEVTAB_STRIPE_AUTOMATIC_TAX decides on Stripe Tax.
# DEVTAB_STRIPE_MANAGED_PAYMENTS=true
# DEVTAB_STRIPE_AUTOMATIC_TAX=false
# hosted: Stripe's page; embedded: Stripe's form in the site's page, which
# needs the publishable key of the same mode (public by design).
# DEVTAB_STRIPE_CHECKOUT_UI=hosted
# DEVTAB_STRIPE_PUBLISHABLE_KEY=
# The webhook destination is created with the same API version.
# DEVTAB_STRIPE_API_VERSION=2026-11-18.endive
# DEVTAB_STRIPE_API_URL=https://api.stripe.com
# DEVTAB_STRIPE_TIMEOUT=8           # seconds per attempt of a request
# DEVTAB_STRIPE_WEBHOOK_TOLERANCE=300  # seconds a webhook's signature stays valid

# --- The trial without a card ----------------------------------------------
# Its length, 7 to 14 days (any other value is refused at start), and the plan
# whose seats it gives. Unset: no trial is offered.
# DEVTAB_TRIAL_DAYS=14
# DEVTAB_TRIAL_PLAN=pro-monthly

# --- Mail ---------------------------------------------------------------------
# Who sends the API's mails: none (they wait in the queue), log (logged, not
# sent; refused in prod) or listmonk (its transactional API). Supabase Auth's
# own mails are the Supabase project's.
# DEVTAB_MAIL=none
# DEVTAB_MAIL_FROM=DevTab.Dev <no-reply@example.invalid>
# DEVTAB_MAIL_LISTMONK_URL=https://lm.example.invalid
# DEVTAB_MAIL_LISTMONK_API_USER=devtab
# DEVTAB_MAIL_LISTMONK_API_TOKEN_FILE=/run/secrets/listmonk-token
# The instance's template of each kind and language, as
# `devtab-api admin mail templates --apply` prints it.
# DEVTAB_MAIL_LISTMONK_TEMPLATES=trial-started.en=1,trial-started.ru=2,...
# A private list recipients join before a mail; unset: external mode, which
# needs a listmonk that knows it (v6).
# DEVTAB_MAIL_LISTMONK_LIST_ID=
# DEVTAB_MAIL_TRIAL_REMIND_DAYS=3,1    # days before a trial ends
# DEVTAB_MAIL_RENEWAL_REMIND_DAYS=7    # days before a yearly renewal
