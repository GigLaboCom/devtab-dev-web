# The site's environment: what its server reads when it runs, and the one
# value its build reads. Every value is public (the Supabase key is the
# publishable one); the site holds no secret and no Stripe setting, which
# the API answers with each checkout. README.md, "The site's configuration",
# says what each does.

# --- Build ------------------------------------------------------------------
# The canonical address, written into the pages, the sitemap and robots.txt.
SITE_URL=https://web.example.invalid

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
# The API's internal listener, reachable only from the site.
DEVTAB_API_INTERNAL_URL=http://api:8081
# The Supabase project as the browser reaches it, and its publishable key;
# without both, signing in is off.
DEVTAB_SUPABASE_URL=https://project.example.invalid
DEVTAB_SUPABASE_PUBLISHABLE_KEY=
# DEVTAB_RATE_SIGN_IN_PER_IP=10    # sign-in attempts an hour, by client address
# The ways to sign in this site offers, comma-separated: email (a mail with a
# sign-in link and a one-time code), password (an address and a password,
# with signing up and a reset by mail), google (a Google account). Unset:
# email alone. The Supabase project must allow each one it lists: README.md,
# "What a deployment sets in Supabase". None of that is set here: who sends
# Auth's mails (the sender's address and name, e.g. no-reply@example.invalid)
# is the project's SMTP setting ([auth.email.smtp] in supabase/config.toml),
# and Google's client id and secret are the project's Google provider.
# DEVTAB_SIGN_IN_METHODS=email
# The extension builds /pro/connect/ hands a licence to (their ids, 32 letters
# a-p, comma-separated); their manifests list this site in externally_connectable.
DEVTAB_EXTENSION_IDS=
