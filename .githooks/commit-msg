#!/usr/bin/env bash
#
# Commit message: no AI or agent attribution (AGENTS.md, "No agent
# attribution"), no absolute home path, no address of the global git
# identity and nothing from the maintainer's private list in
# <git common dir>/info/privacy-patterns.
#
# Install once: script/install-hooks.

set -euo pipefail

# shellcheck source=lib.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib.sh"
message="$1"
failed=0
say() { echo "commit-msg: $*" >&2; }

# Comment lines are not part of the message.
text="$(grep -v '^#' "$message" | sed 's#/Us''ers/Shared/##g' || true)"

if printf '%s\n' "$text" |
  grep -qiE '^co-authored-by:.*(claude|anthropic|openai|chatgpt|gpt-|copilot|gemini|codex|cursor|devin|agent|noreply@)'; then
  say "the message credits a model or an agent (Co-Authored-By)"
  failed=1
fi
if printf '%s\n' "$text" |
  grep -qiE 'generated (with|by) \[?(claude|chatgpt|gpt|copilot|codex|gemini|cursor|an? (ai|agent|llm))|🤖'; then
  say "the message has a \"Generated with\" line"
  failed=1
fi

load_patterns
for i in "${!patterns[@]}"; do
  if printf '%s\n' "$text" | grep -qiE -- "${patterns[$i]}"; then
    say "the message has ${labels[$i]}"
    failed=1
  fi
done

if [[ $failed -ne 0 ]]; then
  say "commit refused"
  exit 1
fi
