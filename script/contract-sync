#!/usr/bin/env bash
#
# The extension's side of the contracts, copied byte for byte, with the
# checksums of the copies in each contract's SOURCES.sha256. Nothing is
# imported from the extension's repository at build or test time: these
# copies are all there is, refreshed by hand with this script.
#
#   script/contract-sync <path to a clone of the extension>   copy and record
#   DEVTAB_EXTENSION_DIR=<path> script/contract-sync          the same
#   script/contract-sync --check                              compare the copies with the records
#
# What is copied:
#   contract/licence-v1/
#     packages/licence/lib/{verify,state,base64url,types}.ts -> verifier/   the extension's token check and states
#     packages/licence/testdata/vectors.json -> extension-vectors.json      tokens the extension signed
#     scripts/mock-backend/contract.mjs -> verifier/contract.mjs           the contract's rules as code (issuing
#                                                                         rules, error table, field and catalogue
#                                                                         rules)
#   contract/plans-v1/
#     extension/src/plans/{model,price}.ts -> reader/                     how the extension reads a catalogue
#     extension/src/shared/plansRecord.ts -> reader/plansRecord.ts         and keeps it
# The extension's modules import each other without file extensions; the
# contract tests resolve those with a hook of Node's own (node:module), so
# the copies stay byte for byte what the extension has.

set -euo pipefail

root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"; else shasum -a 256 "$@"; fi
}

# Each contract: its folder, the folders and files of copies in it, and
# "source in the extension's clone:copy in the folder" pairs.
contracts=(licence-v1 plans-v1)
copies_licence_v1=(verifier extension-vectors.json)
files_licence_v1=(
  "packages/licence/lib/verify.ts:verifier/verify.ts"
  "packages/licence/lib/state.ts:verifier/state.ts"
  "packages/licence/lib/base64url.ts:verifier/base64url.ts"
  "packages/licence/lib/types.ts:verifier/types.ts"
  "packages/licence/testdata/vectors.json:extension-vectors.json"
  "scripts/mock-backend/contract.mjs:verifier/contract.mjs"
)
copies_plans_v1=(reader)
files_plans_v1=(
  "extension/src/plans/model.ts:reader/model.ts"
  "extension/src/plans/price.ts:reader/price.ts"
  "extension/src/shared/plansRecord.ts:reader/plansRecord.ts"
)

# The named list of a contract (`files` or `copies`) into the array `list`.
list_of() {
  local name="${1}_${2//-/_}[@]"
  list=("${!name}")
}

check_one() {
  local contract="$1" dir="$root/contract/$1" record listed status=0 list entry
  record="$dir/SOURCES.sha256"
  if [[ ! -s "$record" ]]; then
    echo "contract-sync: contract/$contract/SOURCES.sha256 is missing; run script/contract-sync <extension clone>" >&2
    return 1
  fi
  if ! (cd "$dir" && sha256 -c --status SOURCES.sha256 2>/dev/null); then
    (cd "$dir" && sha256 -c SOURCES.sha256 2>&1 | grep -v ': OK$' >&2) || true
    status=1
  fi
  # Every copy is recorded: nothing among the copies without a checksum.
  listed="$(awk '{print $2}' "$record")"
  list_of copies "$contract"
  while IFS= read -r copy; do
    if ! grep -qxF "$copy" <<<"$listed"; then
      echo "contract-sync: contract/$contract/$copy is not in SOURCES.sha256" >&2
      status=1
    fi
  done < <(cd "$dir" && for entry in "${list[@]}"; do
    if [[ -d "$entry" ]]; then find "$entry" -type f; elif [[ -f "$entry" ]]; then echo "$entry"; fi
  done | sort)
  return $status
}

check() {
  local contract status=0
  for contract in "${contracts[@]}"; do
    check_one "$contract" || status=1
  done
  if [[ $status -ne 0 ]]; then
    echo "contract-sync: the copies differ from SOURCES.sha256; run script/contract-sync <extension clone>" >&2
    exit 1
  fi
  echo "contract-sync: the copies match SOURCES.sha256"
}

copy() {
  local clone="$1" contract dir entry source target copied list
  for contract in "${contracts[@]}"; do
    list_of files "$contract"
    for entry in "${list[@]}"; do
      if [[ ! -f "$clone/${entry%%:*}" ]]; then
        echo "contract-sync: ${entry%%:*} is missing in $clone; is it a clone of the extension?" >&2
        exit 1
      fi
    done
  done
  for contract in "${contracts[@]}"; do
    dir="$root/contract/$contract"
    list_of copies "$contract"
    for entry in "${list[@]}"; do rm -rf "${dir:?}/$entry"; done
    copied=()
    list_of files "$contract"
    for entry in "${list[@]}"; do
      IFS=: read -r source target <<<"$entry"
      mkdir -p "$(dirname "$dir/$target")"
      cp "$clone/$source" "$dir/$target"
      chmod 644 "$dir/$target"
      copied+=("$target")
      echo "copied $source -> contract/$contract/$target"
    done
    (cd "$dir" && sha256 "${copied[@]}" | LC_ALL=C sort -k2 >SOURCES.sha256)
    echo "wrote contract/$contract/SOURCES.sha256"
  done
}

usage() { sed -n '3,25p' "$0" | sed 's/^# \{0,1\}//'; }

case "${1:-}" in
  --check) check ;;
  -h | --help) usage ;;
  "")
    if [[ -n "${DEVTAB_EXTENSION_DIR:-}" ]]; then
      copy "$DEVTAB_EXTENSION_DIR"
    else
      usage >&2
      exit 1
    fi
    ;;
  *) copy "$1" ;;
esac
