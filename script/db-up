#!/usr/bin/env bash
#
# Starts the local database for the API: Postgres 17 of the local Supabase
# stack (supabase/config.toml) on port 54330, database `postgres`, and nothing
# else of the stack. On its first start the CLI applies every migration in
# supabase/migrations/. Then gives the API role its local password (generated
# into the ignored .state/ on first use) and prints the connection strings.
#
#   script/db-up
#
# Stop it with: supabase stop (its data stays in a Docker volume).

set -euo pipefail

# shellcheck source=lib/supabase.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/supabase.sh"

supabase_cli db start
set_api_password

echo "Postgres is up. Connection strings:"
echo "  owner (migrations, tests): $(local_db_url)"
echo "  API:                       postgresql://devtab_api:<.state/devtab_api.password>@127.0.0.1:54330/postgres"
