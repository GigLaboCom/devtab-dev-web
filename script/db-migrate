#!/usr/bin/env bash
#
# Applies the migrations in supabase/migrations/ that the local database does
# not have yet (supabase migration up --local), then gives the API role its
# local password, in case a migration has just created it.
#
#   script/db-migrate

set -euo pipefail

# shellcheck source=lib/supabase.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/supabase.sh"

supabase_cli migration up --local
set_api_password
