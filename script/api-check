#!/usr/bin/env bash
#
# Every check of the API, in order: rustfmt, clippy with warnings as errors,
# the tests (the database tests against the local database from script/db-up)
# and cargo deny. CI runs the same.
#
#   script/api-check
#
# DEVTAB_TEST_DATABASE_URL names another database for the tests (the owner's
# URL; default: the local one, as `supabase status` reports it).

set -euo pipefail

# shellcheck source=lib/supabase.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/supabase.sh"
cd "$root"

if [[ -z "${DEVTAB_TEST_DATABASE_URL:-}" ]]; then
  DEVTAB_TEST_DATABASE_URL="$(local_db_url)"
fi
export DEVTAB_TEST_DATABASE_URL

cargo fmt --all -- --check
# Clippy reports a warm cache as clean for lints it never re-evaluated: touch
# the crate roots so that it checks them again.
touch api/src/lib.rs api/src/main.rs
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace
cargo deny check
