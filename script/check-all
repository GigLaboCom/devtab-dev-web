#!/usr/bin/env bash
#
# Everything CI checks: the site (pnpm check), then the API (script/api-check,
# which needs the local database: script/db-up && script/db-migrate). Run it
# before a commit that touches api/, db/ or deploy/.
#
#   script/check-all

set -euo pipefail

root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"

pnpm check
script/api-check
