#!/usr/bin/env bash
#
# Everything CI checks: the site (pnpm check), the generated files
# (script/gen --check), the licence and plans contracts with the extension
# (pnpm test:contract), then the API (script/api-check, which needs the local
# database: script/db-up). Run it before a commit that touches api/,
# supabase/, config/, contract/ or .sqlx/.
#
#   script/check-all

set -euo pipefail

root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$root"

pnpm check
script/gen --check
pnpm test:contract
script/api-check
