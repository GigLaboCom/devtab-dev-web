#!/usr/bin/env bash
#
# Recreates the local database and applies every migration in
# supabase/migrations/ from zero (supabase db reset --local). Everything in
# the database is lost, the API role included; it gets its local password
# from .state/ again.
#
#   script/db-reset

set -euo pipefail

# shellcheck source=lib/supabase.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/supabase.sh"

supabase_cli db reset --local
set_api_password
